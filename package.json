{
  "name": "@swampratnz/agent-base",
  "version": "0.0.1",
  "description": "Community-agnostic base framework for Claude Agent SDK bots: platform adapters, RBAC, persistent memory, confirm-gated tools, and a module API for building specific agents on top.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/storage/schema/*.sql dist/storage/schema/ && node scripts/check-dist-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "test:security": "LOG_LEVEL=${LOG_LEVEL:-silent} node scripts/check-security-test-count.mjs",
    "test:security:fix": "node scripts/check-security-test-count.mjs --write",
    "context:check": "node scripts/check-context-pack.mjs",
    "context:fix": "node scripts/check-context-pack.mjs --write",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "tsx src/storage/migrate.ts",
    "migrate:prod": "node dist/storage/migrate.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swampratnz/agent-base.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@hapi/boom": "^10.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@whiskeysockets/baileys": "6.7.24",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "undici": "^6.27.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.3",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "undici": "^6.27.0",
    "brace-expansion": "^5.0.8",
    "protobufjs": "^7.6.5",
    "sharp": "^0.35.3"
  }
}
