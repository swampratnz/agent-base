# Placeholders only. Never commit a real value; `.env` is git-ignored.
# Every variable here is a field in one of the base's config slices — the base
# parses them all once, at import time, and fails fast on anything missing or
# malformed. So this is the full REQUIRED set as of agent-base 0.3.0, not a
# menu: leave one out and the process refuses to start. The version stamp is
# the point: when the framework adds a config field, this file is where a
# scaffolded repo finds out, and a stale stamp is the warning that nobody has
# checked since.

# The storage spine. `npm run migrate` needs THIS AND NOTHING ELSE — it imports
# the migration runner directly, and the base validates only its db + log
# slices on that path.
DATABASE_URL=postgres://user:password@localhost:5432/my_agent

# Model credential. Treat as a secret: the base redacts its exact value from
# every outbound message.
CLAUDE_CODE_OAUTH_TOKEN=replace-me

# Discord is not optional today — both of these are required by the base's
# config slice even if you never start the adapter.
DISCORD_BOT_TOKEN=replace-me
DISCORD_GUILD_ID=replace-me

# 'baileys' | 'cloud' | 'disabled'. Defaults to 'baileys', so set it to
# 'disabled' explicitly unless you are running WhatsApp; 'cloud' additionally
# requires the four WHATSAPP_CLOUD_* variables.
WHATSAPP_PROVIDER=disabled

# A module cannot declare its own env slice yet — there is no `configSchema` on
# the manifest, so every variable the base parses is defined in the base's own
# config slices. Read your own settings from somewhere else (a policy key, a
# config file) or raise it upstream; do not read process.env from a tool.
