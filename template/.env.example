# Placeholders only. Never commit a real value; `.env` is git-ignored.
# Each variable here must correspond to a field in a config slice — the base
# fails fast at startup on anything missing or malformed.

# Required by the storage spine. Migrations need only this.
DATABASE_URL=postgres://user:password@localhost:5432/my_agent

# Model credential. Treat as a secret; register it for outbound redaction.
CLAUDE_CODE_OAUTH_TOKEN=replace-me

# One per platform you enable.
# DISCORD_BOT_TOKEN=replace-me
# DISCORD_GUILD_ID=replace-me

# Your module's own slice (see src/module/index.ts configSchema).
# MY_AGENT_FEATURE_ENABLED=false
