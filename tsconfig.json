{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    // Explicit, unlike community-agent's tsconfig, which gets the Node globals
    // only incidentally: nothing there sets `types`, and the ambient
    // declarations arrive through a `/// <reference types="node" />` inside a
    // runtime dependency's .d.ts (dotenv's). This package has no such
    // dependency, so `node:test`/`node:assert` in tests would not resolve.
    // Naming it here is both the fix and the honest form of what that repo
    // relies on by accident.
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // `true` (community-agent has `false`): this package is consumed as a
    // published library, so the .d.ts files are the product.
    "declaration": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
